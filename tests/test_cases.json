        "arguments": { "customer_id": "CUST_88392", "verification_code": "4321" },
        "expected_status": "success"
      },
      {
        "name": "mark_disposition",
        "arguments": { "customer_id": "CUST_88392", "disposition": "ALREADY_PAID", "notes": "Customer claims paid yesterday via UPI Ref UTR998822" },
        "expected_status": "success"
      }
    ]
  },
  {
    "scenario_id": "TEST_04_DISPUTE_ESCALATION",
    "name": "Edge Case - Debt Dispute Escalation",
