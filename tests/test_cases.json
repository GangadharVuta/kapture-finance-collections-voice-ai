        "arguments": { "customer_id": "CUST_88392", "verification_code": "4321" },
        "expected_status": "success"
      },
      {
        "name": "escalate_to_agent",
        "arguments": { "customer_id": "CUST_88392", "reason": "DEBT_DISPUTE", "call_summary": "Customer disputes late fee charges" },
        "expected_status": "success"
      },
      {
        "name": "mark_disposition",
        "arguments": { "customer_id": "CUST_88392", "disposition": "DISPUTE", "notes": "Disputed interest charges, escalated to agent" },
        "expected_status": "success"
      }
    ]
  },
  {
