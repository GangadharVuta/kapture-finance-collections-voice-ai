[
  {
    "scenario_id": "TEST_01_HAPPY_PATH_PTP",
    "name": "Happy Path - Identity Verified & Promise to Pay Collected",
    "description": "Customer confirms identity with code '4321', agrees to pay ₹8499 by 2026-08-20, receives payment link, and disposition PTP_COLLECTED is logged.",
    "tool_calls": [
      {
        "name": "verify_customer",
        "arguments": { "customer_id": "CUST_88392", "verification_code": "4321" },
        "expected_status": "success",
        "expected_verified": true
      },
      {
        "name": "log_promise_to_pay",
        "arguments": { "customer_id": "CUST_88392", "ptp_date": "2026-08-20", "ptp_amount": 8499, "payment_channel": "UPI_LINK" },
        "expected_status": "success"
      },
      {
        "name": "send_payment_link",
        "arguments": { "customer_id": "CUST_88392", "phone_number": "+919876543210", "amount": 8499 },
        "expected_status": "success"
      },
      {
        "name": "mark_disposition",
        "arguments": { "customer_id": "CUST_88392", "disposition": "PTP_COLLECTED", "notes": "Agreed to pay full amount by 20th Aug" },
        "expected_status": "success"
      }
    ]
  },
  {
    "scenario_id": "TEST_02_AUTH_FAILURE",
